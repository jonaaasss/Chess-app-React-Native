rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Backups: each person reads and writes only their own.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // "Share my data with Claude" (src/claudeShare.ts): a copy under a long
    // secret code. Whoever knows the code can read it (listing is never
    // allowed, so a code can't be found); only its owner writes it.
    match /shared/{code} {
      function sharedDoc() {
        return /databases/$(database)/documents/shared/$(code);
      }
      function isOwner() {
        return request.auth != null && exists(sharedDoc()) && get(sharedDoc()).data.owner == request.auth.uid;
      }
      allow get: if code.size() >= 40;
      allow create: if request.auth != null && code.size() >= 40 && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /chunks/{chunk} {
        allow get: if true;
        allow write: if isOwner();
      }

      // A version Claude prepared: only used when the owner taps
      // "Load Claude's changes" (and that can be undone).
      match /fromClaude/{part} {
        allow get: if true;
        allow create, update: if exists(sharedDoc()) && part.matches('meta|c[0-9]{4}') && request.resource.data.size() <= 8;
        allow delete: if isOwner();
      }
    }
  }
}
